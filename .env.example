# SceneNav AI — Environment Configuration
# Copy this file to .env and fill in your values

# Backend
SCENAV_HOST=127.0.0.1
SCENAV_PORT=8000
SCENAV_RELOAD=true
SCENAV_LOG_LEVEL=info

# CORS — restrict to frontend origin in production
SCENAV_CORS_ORIGINS=http://localhost:5173

# Storage
SCENAV_RESULTS_DIR=results
SCENAV_DATA_DIR=data
SCENAV_MAX_UPLOAD_MB=50
SCENAV_MAX_IMAGE_DIM=8192

# Algorithm defaults
SCENAV_ORB_MAX_FEATURES=5000
SCENAV_RATIO_THRESHOLD=0.75
SCENAV_RANSAC_REPROJ_THRESHOLD=4.0
SCENAV_MIN_INLIERS=10
